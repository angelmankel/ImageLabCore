# ImageLab custom node — environment variables.
#
# These are read by the node's Python process (which runs inside ComfyUI).
# Set them wherever ComfyUI runs:
#   - LAN boxes  → in the systemd unit / docker-compose / shell that launches ComfyUI
#   - RunPod     → in the pod template's environment section
#
# Copy this to `.env` and fill in your values (or paste them into RunPod).


# ── CivitAI auth ──────────────────────────────────────────────────────────
# CivitAI API token. Required for downloading gated models; optional for
# public ones. Generate at: https://civitai.com/user/account → API Keys.
CIVITAI_API_KEY=


# ── Startup auto-download ─────────────────────────────────────────────────
# Comma- or newline-separated list of models to download on ComfyUI startup.
# Each entry is one of:
#
#   128713                                          a CivitAI version id
#   https://civitai.com/models/4384?modelVersionId=128713   a version URL
#   https://civitai.com/models/4384                 a model URL → latest version
#   model:4384                                      shorthand for the above
#   upscale_models::128713                          force the destination folder
#
# Bare entries auto-derive the folder from CivitAI's model type. Use the
# `<folder>::<entry>` override when the type doesn't map cleanly. Common
# folders: checkpoints, loras, vae, embeddings, upscale_models, controlnet,
# hypernetworks, clip, clip_vision, diffusion_models.
#
# Failures don't block the rest of the list — each entry is queued independently.
IMAGELAB_AUTO_DOWNLOAD=


# ── Optional: CivitAI endpoint overrides ──────────────────────────────────
# Point at a proxy / mirror. Defaults below; uncomment to override.
#CIVITAI_API_BASE=https://civitai.com/api/v1
#CIVITAI_DOWNLOAD_BASE=https://civitai.com/api/download/models
